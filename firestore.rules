rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 투표 마감: 2026-12-07 24:00 KST = 2026-12-07 15:00 UTC (index.html의 DEADLINE과 동일)
    function deadline() { return timestamp.date(2026, 12, 7) + duration.value(15, 'h'); }

    function signedIn() { return request.auth != null; }
    function sessionPath() { return /databases/$(database)/documents/sessions/$(request.auth.uid); }
    function authed() { return signedIn() && exists(sessionPath()); }
    function myKey() { return get(sessionPath()).data.memberKey; }
    function myAuthorId() {
      return get(/databases/$(database)/documents/members/$(myKey())).data.authorId;
    }

    // 조합원 명부: 관리자 스크립트로만 작성, 본인 문서만 읽기 가능 (목록 조회 불가)
    match /members/{key} {
      allow get: if authed() && key == myKey();
      allow list, write: if false;
    }

    // 로그인 세션: 명부에 있는 memberKey일 때만 생성 가능
    match /sessions/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['memberKey', 'createdAt'])
        && request.resource.data.memberKey is string
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/members/$(request.resource.data.memberKey));
      allow list, update, delete: if false;
    }

    // 투표: 조합원당 1표, 마감 전까지 수정 가능, 본인 투표만 조회 가능
    match /votes/{key} {
      allow get: if authed() && key == myKey();
      allow create, update: if authed() && key == myKey()
        && request.time < deadline()
        && request.resource.data.keys().hasOnly(['choice', 'updatedAt'])
        && request.resource.data.choice in ['agree', 'disagree']
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }

    // 집계 결과: 관리자 스크립트가 작성, 마감 이후에만 조합원 조회 가능
    match /meta/result {
      allow get: if authed() && request.time >= deadline();
      allow write: if false;
    }

    // 게시글
    match /posts/{id} {
      allow read: if authed();
      allow create: if authed()
        && request.resource.data.keys().hasOnly(['title', 'body', 'authorId', 'createdAt', 'deleted'])
        && request.resource.data.authorId == myAuthorId()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000
        && request.resource.data.createdAt == request.time
        && request.resource.data.deleted == false;
      allow update: if authed() && resource.data.authorId == myAuthorId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'body']);
      allow delete: if false;   // 삭제는 '삭제된 글' 처리(soft delete)만 허용
    }

    // 댓글·답글 (parentId가 null이면 댓글, 값이 있으면 답글)
    match /comments/{id} {
      allow read: if authed();
      allow create: if authed()
        && request.resource.data.keys().hasOnly(['postId', 'parentId', 'body', 'authorId', 'createdAt', 'deleted'])
        && request.resource.data.authorId == myAuthorId()
        && request.resource.data.postId is string
        && (request.resource.data.parentId == null || request.resource.data.parentId is string)
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.deleted == false;
      allow update: if authed() && resource.data.authorId == myAuthorId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'body']);
      allow delete: if false;
    }
  }
}
